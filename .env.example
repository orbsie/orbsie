# Cloud accounts and saving. Configure privately in Vercel and .env.local.
DATABASE_URL=
# Private Google Cloud Storage archives, authenticated through Vercel OIDC.
GCS_BUCKET=
GCP_WORKLOAD_IDENTITY_PROVIDER=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://orbsie.com
# Optional Google account sign-in (separate from AI connection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated static Orb deployments. This is NOT an AI Gateway API key.
VERCEL_DEPLOY_TOKEN=
VERCEL_TEAM_ID=
MAX_PUBLISHED_ORBS=5
# Optional live integration testing only. Never NEXT_PUBLIC_ or committed.
OPENROUTER_TEST_KEY=
AI_GATEWAY_TEST_KEY=
# Optional server-owned output cap (1–10000). Set 512 for the local Luna key.
# Invalid values fail closed. The public free path also keeps its 4096 ceiling.
ORBSIE_GENERATION_MAX_TOKENS=
# Remembered provider credentials are intentionally not implemented.
# Session keys live only in tab memory; BYOK generation does not require an Orbsie account.

# Private server-only free prompts. Configure production as a sensitive Vercel variable.
AI_GATEWAY_API_KEY_FREE=
FREE_PROMPTS_DAILY_LIMIT=100
# Waitlist confirmation delivery (verified sender required).
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=
